    "allHead": "<meta name=\"robots\" content=\"noindex, nofollow\"><style>#passwordOverlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);display:flex;justify-content:center;align-items:center;z-index:99999;flex-direction:column;backdrop-filter:blur(4px);}#passwordOverlay .box{background:#fff;padding:40px 50px;border-radius:16px;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.5);max-width:400px;width:90%;}#passwordOverlay .box h2{margin:0 0 8px 0;font-size:24px;color:#222;}#passwordOverlay .box p{margin:0 0 20px 0;color:#666;font-size:14px;}#passwordOverlay input{padding:12px 16px;font-size:16px;border:2px solid #ddd;border-radius:8px;width:100%;box-sizing:border-box;outline:none;transition:border .3s;}#passwordOverlay input:focus{border-color:#1f883d;}#passwordOverlay button{padding:12px 32px;font-size:16px;background:#1f883d;color:#fff;border:none;border-radius:8px;cursor:pointer;margin-top:16px;width:100%;font-weight:bold;transition:background .3s;}#passwordOverlay button:hover{background:#156c2e;}#passwordOverlay .error{color:#d73a49;margin-top:12px;font-size:14px;min-height:20px;}</style><div id=\"passwordOverlay\"><div class=\"box\"><h2>🔐 输入密码</h2><p>请输入访问密码以继续</p><input type=\"password\" id=\"passwordInput\" placeholder=\"请输入密码...\" autofocus><button onclick=\"verifyPassword()\">确认</button><div id=\"errorMsg\" class=\"error\"></div></div></div><script>const CORRECT_PASSWORD = \"DonotrepostBenicePeace&LOVE\";function verifyPassword(){var e=document.getElementById(\"passwordInput\"),t=document.getElementById(\"errorMsg\");e.value===CORRECT_PASSWORD?document.getElementById(\"passwordOverlay\").style.display=\"none\":(t.textContent=\"❌ 密码错误，请重试\",e.value=\"\",e.focus())}document.getElementById(\"passwordInput\").addEventListener(\"keydown\",function(e){e.key===\"Enter\"&&verifyPassword()});window.addEventListener(\"load\",function(){document.getElementById(\"passwordOverlay\").style.display=\"flex\";document.getElementById(\"passwordInput\").focus()});</script>"
}
